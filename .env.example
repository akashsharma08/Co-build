# Shared / Compose
NODE_ENV=production
POSTGRES_USER=cobuild
POSTGRES_PASSWORD=cobuild
POSTGRES_DB=cobuild
POSTGRES_PORT=5433

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Host access (pnpm/migrations from your machine)
DATABASE_URL=postgresql://cobuild:cobuild@localhost:5433/cobuild
DATABASE_SSL=false
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# Optional OAuth (leave blank to hide social login buttons)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Web
WEB_PORT=3000
# Baked into the Next.js image at build time (browser calls the API on the host)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
